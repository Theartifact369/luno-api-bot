# Luno API credentials (candles + orders). Read-only (MP_None) recommended
# for paper trading. Keys are loaded from this .env file.
LUNO_API_KEY_ID=your_key_id
LUNO_API_SECRET=your_secret


LUNO_PAIR=XBTZAR
INITIAL_BALANCE=100000.0
SCAN_INTERVAL=60
MAX_DAILY_TRADES=5

# Strategy: "regime" = daily SMA50/200 trend filter (all-in on golden cross,
# cash on death cross — the backtest winner). "rules" = old weighted score.
STRATEGY=regime

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
DATA_DIR=

# Headless/daemon mode (no TUI)
HEADLESS=false

# Optional: LLM provider for AI-powered decisions
# Set to "none" for rules-only technical analysis
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4
#
# Governance runs RULES-BASED with no API key at all: after every 10 trades or
# hourly it reviews the paper record and tightens stop-loss / position size /
# daily trade cap after losing streaks or deep drawdowns, logging each decision
# to governance_state.json. Setting an LLM provider above upgrades it.

# Optional: Kronos K-line forecasting endpoint (HF Space or self-hosted)
# Leave unset to disable. Forecasts are one factor in scoring, refreshed hourly.
# KRONOS_URL=https://your-kronos-space.hf.space
# KRONOS_HORIZON=5
# KRONOS_REFRESH_SECONDS=900
# KRONOS_THRESHOLD_PCT=0.5
